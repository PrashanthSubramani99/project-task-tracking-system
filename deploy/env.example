## Copy this to /opt/infytrack/.env on the server (NOT into the repo) and
## fill in real values. The systemd unit (infytrack.service) loads it via
## EnvironmentFile.

# Required. Generate with: openssl rand -hex 32
JWT_SECRET=

# Optional — defaults shown.
PORT=4000
DATA_DIR=/opt/infytrack/server/data
TOKEN_TTL=30d
SWEEP_INTERVAL_MIN=30
