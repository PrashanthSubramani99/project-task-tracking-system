{
  "name": "infytrack",
  "version": "1.0.0",
  "private": true,
  "description": "Turn team discussions into tracked work — meetings, action items, tasks, docs and reports.",
  "scripts": {
    "setup": "npm --prefix server install && npm --prefix client install",
    "seed": "npm --prefix server run seed",
    "reset": "npm --prefix server run reset",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server start",
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "test": "npm --prefix server test"
  },
  "engines": {
    "node": ">=20"
  }
}
